# Copy this file to .env and adjust. python-dotenv loads it automatically when
# present, OR set these as real environment variables on your server.

# --- Storage --------------------------------------------------------------
# Where the database + uploaded attachments are written.
# On Windows this defaults to D:\EngCMMS automatically if left unset.
# ENGCMMS_DATA_DIR=D:\EngCMMS

# --- Security -------------------------------------------------------------
# A stable secret is auto-generated in the data dir if unset; override here
# to share sessions across multiple app servers.
# ENGCMMS_SECRET_KEY=change-me-to-a-long-random-string

# Initial admin password (only used the first time the DB is created).
# ENGCMMS_ADMIN_PASSWORD=changeme

# --- Branding -------------------------------------------------------------
ENGCMMS_ORG_NAME=Advanced Diagnostics Engineering
ENGCMMS_EMAIL_DOMAIN=lab.doe.local

# --- Email (leave blank for safe "preview" mode) --------------------------
# ENGCMMS_MAIL_SERVER=smtp.internal.doe.local
# ENGCMMS_MAIL_PORT=25
# ENGCMMS_MAIL_USE_TLS=false
# ENGCMMS_MAIL_USERNAME=
# ENGCMMS_MAIL_PASSWORD=
# ENGCMMS_MAIL_SENDER=engcmms-noreply@lab.doe.local

# --- Misc -----------------------------------------------------------------
# ENGCMMS_ENV=production
# ENGCMMS_MAX_UPLOAD_MB=32
# ENGCMMS_DATABASE_URI=sqlite:///D:/EngCMMS/engcmms.db
